# ─── База (Neon Postgres) ────────────────────────────────────────────────────
# Пулер — для рантайма в serverless-функциях.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/osnovanie?sslmode=require&pgbouncer=true&connection_limit=1"
# Прямое подключение — только для миграций.
DIRECT_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/osnovanie?sslmode=require"

# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=""
# Имя бота для Login Widget в браузере.
TELEGRAM_BOT_USERNAME=""
# Секрет, которым Telegram подписывает вебхук (X-Telegram-Bot-Api-Secret-Token).
TELEGRAM_WEBHOOK_SECRET=""

# ─── Аутентификация ──────────────────────────────────────────────────────────
# Подпись собственных JWT. Сгенерировать: openssl rand -base64 48
JWT_SECRET=""

# ─── Планировщик ритуалов ────────────────────────────────────────────────────
# Защита эндпоинта /api/cron/rituals. Вызывается GitHub Actions каждые 15 минут.
CRON_SECRET=""

# ─── Администраторы ──────────────────────────────────────────────────────────
# Telegram ID через запятую — получают role=ADMIN при первом входе.
ADMIN_TELEGRAM_IDS=""

# ─── Прочее ──────────────────────────────────────────────────────────────────
# Публичный адрес приложения (нужен для ссылок бота на Mini App).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
