{
  "name": "osnovanie",
  "version": "0.1.0",
  "private": true,
  "description": "Основание — приложение для вживления Философии Основания",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "canon:report": "tsx scripts/canon-report.mts",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma migrate dev",
    "canon:import": "tsx scripts/import-canon.mts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.11",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
